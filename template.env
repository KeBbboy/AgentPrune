BASE_URL=""
API_KEY=""

# Optional Selective Context compression for inter-agent messages.
# Enable only after installing or caching the scoring model locally.
SELECTIVE_CONTEXT_ENABLED="1"
SELECTIVE_CONTEXT_MODEL="distilgpt2"
SELECTIVE_CONTEXT_REDUCE_RATIO="0.5"
SELECTIVE_CONTEXT_GRANULARITY="phrase"
SELECTIVE_CONTEXT_PRESERVE_FIRST_LINE="1"
SELECTIVE_CONTEXT_MIN_CHARS="0"
SELECTIVE_CONTEXT_MIN_UNITS="1"
SELECTIVE_CONTEXT_PRESERVE_FIRST_UNITS="0"
SELECTIVE_CONTEXT_PRESERVE_LAST_UNITS="0"
